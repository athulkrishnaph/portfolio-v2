# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is git-ignored. Never commit real secrets.

# PostgreSQL connection string used by the Go backend.
# Native install example (user/password you created with psql, see README):
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Secret used to sign JWTs. Use a long random value (32+ chars).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long an admin login stays valid (Go duration format: 30m, 2h, 24h).
JWT_TTL=2h

# Port the Go API listens on.
SERVER_PORT=8080

# Where uploaded images are stored (local storage driver). Relative to backend/.
UPLOAD_DIRECTORY=./uploads

# Optional: store uploads in Supabase Storage (free, no card) so they survive
# restarts on hosts without a persistent disk. Create a PUBLIC bucket, then set:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_BUCKET=uploads
# SUPABASE_SERVICE_KEY=service_role key (Project Settings > API). Keep it secret.

# Public base URL of the API, used to build absolute URLs for uploaded files.
PUBLIC_BASE_URL=http://localhost:8080

# Optional: "Sign in with Google" on the admin login (password login keeps
# working). OAuth client ID of type "Web application" from Google Cloud
# Console; only emails of existing admin accounts can sign in.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Set to true ONLY when the API runs behind a reverse proxy you control
# (nginx, a load balancer). The API then reads the client IP from
# X-Real-IP / X-Forwarded-For, which the login rate limiter uses.
TRUST_PROXY=false

# Folder containing SQL migrations and seeds. Relative to backend/.
MIGRATIONS_DIR=../database/migrations
SEEDS_DIR=../database/seeds

# Production only: folder with the built Angular app, which the API then
# serves itself (one server, one origin). Leave empty in development.
# STATIC_DIR=../frontend/dist/frontend/browser

# Docker only: password for the PostgreSQL container (docker compose).
# POSTGRES_PASSWORD=portfolio

# ---- AI assistant (optional) --------------------------------------------------
# Portfolio chatbot: answers visitors' questions from your portfolio content
# (RAG with PostgreSQL + pgvector, answers by Google Gemini). Leave
# GEMINI_API_KEY empty to disable it; the rest of the site is unaffected.
# The key stays on the server and is never sent to the browser.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (check https://ai.google.dev/gemini-api/docs/models for current names).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match vector(N) in database/migrations/008_knowledge_chunks.up.sql.
# See README → "Changing the embedding model" before changing it.
GEMINI_EMBEDDING_DIMENSIONS=768

# Retrieval: chunks sent to the model per question, and the minimum cosine
# similarity (0–1) a chunk needs to count as relevant.
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.6

# Abuse protection: questions per visitor (IP) per minute / per day, and a
# site-wide daily cap that keeps you inside the Gemini free tier (0 = no cap).
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=100
CHAT_DAILY_LIMIT=300

# Optional extra knowledge as Markdown files (e.g. achievements.md). Relative to backend/.
KNOWLEDGE_DIR=../database/knowledge

# Used once by `go run ./cmd/createadmin` to create the admin account.
# The example password below is deliberately refused: pick your own
# (at least 10 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
