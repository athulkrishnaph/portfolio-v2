# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is git-ignored. Never commit real secrets.

# PostgreSQL connection string used by the Go backend.
# Native install example (user/password you created with psql, see README):
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Secret used to sign JWTs. Use a long random value (32+ chars).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long an admin login stays valid (Go duration format: 30m, 2h, 24h).
JWT_TTL=2h

# Port the Go API listens on.
SERVER_PORT=8080

# Where uploaded images are stored (local storage driver). Relative to backend/.
UPLOAD_DIRECTORY=./uploads

# Public base URL of the API, used to build absolute URLs for uploaded files.
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Set to true ONLY when the API runs behind a reverse proxy you control
# (nginx, a load balancer). The API then reads the client IP from
# X-Real-IP / X-Forwarded-For, which the login rate limiter uses.
TRUST_PROXY=false

# Folder containing SQL migrations and seeds. Relative to backend/.
MIGRATIONS_DIR=../database/migrations
SEEDS_DIR=../database/seeds

# Production only: folder with the built Angular app, which the API then
# serves itself (one server, one origin). Leave empty in development.
# STATIC_DIR=../frontend/dist/frontend/browser

# Docker only: password for the PostgreSQL container (docker compose).
# POSTGRES_PASSWORD=portfolio

# Used once by `go run ./cmd/createadmin` to create the admin account.
# The example password below is deliberately refused: pick your own
# (at least 10 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
