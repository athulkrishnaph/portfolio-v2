# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Uploaded files (local storage)
uploads/
backend/uploads/

# Go build output
backend/bin/
*.exe

# Node / Angular (frontend has its own .gitignore too)
node_modules/
frontend/dist/
frontend/.angular/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
