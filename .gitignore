# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Uploaded files (local storage runtime folder only — NOT backend/internal/uploads,
# which is source code). Anchored to the repo root so it can't match a
# same-named folder elsewhere, e.g. backend/internal/uploads/.
/backend/uploads/

# Go build output
backend/bin/
*.exe

# Node / Angular (frontend has its own .gitignore too)
node_modules/
frontend/dist/
frontend/.angular/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
